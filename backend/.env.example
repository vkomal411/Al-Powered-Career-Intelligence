# =====================================================================
# CareerPilot AI Backend Environment Variables
# =====================================================================

# PostgreSQL Connection String (SQLAlchemy psycopg3 format)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_platform

# Cryptographically Secure JWT Secret Key (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generate_a_secure_random_key_with_at_least_32_characters_here

# JWT Algorithm and Expiration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Client ID (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Allowed Frontend URL (CORS & Cookie Scope)
FRONTEND_ORIGIN=http://localhost:3000

# Deployment Environment ('development' | 'production')
ENVIRONMENT=production

# Security Settings
MAX_RESUME_UPLOAD_MB=5
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# AI Intelligence Providers ('gemini' | 'openai' | 'offline')
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
